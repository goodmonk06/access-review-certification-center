{
  "name": "access-review-certification-center",
  "version": "1.0.0",
  "description": "Access review and certification system for periodic access audits",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd backend && npm run start",
    "test": "cd backend && npm run test",
    "test:watch": "cd backend && npm run test:watch",
    "test:coverage": "cd backend && npm run test:coverage",
    "lint": "npm run lint:backend",
    "lint:backend": "cd backend && npm run lint",
    "lint:fix": "npm run lint:fix:backend",
    "lint:fix:backend": "cd backend && npm run lint:fix",
    "format": "npm run format:backend",
    "format:backend": "cd backend && npm run format",
    "typecheck": "npm run typecheck:backend",
    "typecheck:backend": "cd backend && npm run typecheck",
    "db:generate": "cd backend && npm run db:generate",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:push": "cd backend && npm run db:push",
    "db:seed": "cd backend && npm run db:seed",
    "db:reset": "cd backend && npm run db:reset",
    "db:studio": "cd backend && npm run db:studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:rebuild": "docker-compose up -d --build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
